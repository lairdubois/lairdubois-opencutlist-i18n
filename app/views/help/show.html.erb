<% content_for :title, "#{t(".title")} · OpenCutList Localize" %>
<% if @open_count&.positive? %>
  <p class="mb-4 rounded bg-sky-50 px-3 py-2 text-sm text-sky-900">
    <%= t(".open_requests", count: @open_count) %> <%= link_to t(".see_requests"), help_requests_path, class: "underline" %>
  </p>
<% end %>
<div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_20rem]">
  <%# The guide, one partial per locale (_guide.fr / _guide.en) : prose, styled from here %>
  <article class="text-sm leading-6 text-stone-700 [&_h1]:mb-4 [&_h1]:text-lg [&_h1]:font-semibold [&_h1]:text-stone-900
                  [&_h2]:mt-8 [&_h2]:mb-2 [&_h2]:font-semibold [&_h2]:text-stone-900 [&_p]:mb-2 [&_ul]:mb-2 [&_ul]:list-disc [&_ul]:pl-5
                  [&_li]:mb-1 [&_strong]:font-medium [&_strong]:text-stone-900
                  [&_code]:rounded [&_code]:bg-stone-100 [&_code]:px-1 [&_code]:font-mono [&_code]:text-xs
                  [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-b-2 [&_kbd]:border-stone-300 [&_kbd]:bg-white [&_kbd]:px-1 [&_kbd]:font-sans [&_kbd]:text-xs
                  [&_dl]:mb-2 [&_dl]:grid [&_dl]:grid-cols-[auto_1fr] [&_dl]:gap-x-4 [&_dl]:gap-y-1 [&_dt]:whitespace-nowrap">
    <%= render "guide" %>
  </article>

  <%# The form to the admins, beside the guide (under it on a phone), kept on screen below the header %>
  <aside id="contact" class="rounded border border-stone-200 bg-white p-4 text-sm md:sticky md:top-[calc(3.5rem+1px+1.5rem)]">
    <h2 class="mb-1 font-semibold"><%= t(".contact") %></h2>
    <p class="mb-3 text-stone-600"><%= t(".contact_hint") %></p>
    <%= form_with url: help_requests_path, class: "flex flex-col gap-2", data: { controller: "dirty-form" } do %>
      <%= hidden_field_tag :page, @page %>
      <%= text_area_tag :body, nil, rows: 6, required: true, maxlength: 5000, placeholder: t(".placeholder"),
                        data: { controller: "autosize", action: "input->autosize#resize" },
                        class: "block w-full resize-none overflow-hidden rounded border border-stone-300 px-2 py-1" %>
      <% if @page %>
        <p class="truncate text-xs text-stone-500" title="<%= @page %>"><%= t(".page") %> <code><%= @page %></code></p>
      <% end %>
      <p class="text-xs text-stone-500"><%= t(".reply_hint", email: current_user.email) %></p>
      <%= submit_tag t(".send"), class: "self-end rounded bg-stone-800 px-3 py-1 text-white" %>
    <% end %>
  </aside>
</div>
