<% content_for :title, "#{@language.name} · OpenCutList Localize" %>
<%# reference : the ref-en class shows the en reference instead of the fr source in the rows, switched without a reload %>
<div data-controller="reference" data-reference-url-value="<%= reference_language_path %>"
     class="<%= 'ref-en' if @en_reference %>">
<%# Toolbar (filters, search, column headers) stays on screen above the rows (.toolbar in application.css) %>
<div class="toolbar">
  <div class="mb-2 flex flex-wrap items-start gap-3">
    <%= render "shared/search_bar", url: translate_path(@language.code), hidden: {}, counts: @counts, users: @users, count: @count,
                                     sorts: ListFilters::SORTS.keys %>
  </div>

  <% todo = @units.reject(&:copied).select { |u| (t = @data[:translations][u.id]).nil? || t.outdated? } %>
  <div class="flex flex-wrap items-center gap-2 text-sm has-[>:not([hidden])]:mb-2">
    <% if Pretranslator.enabled? && todo.any? %>
      <%= button_to t(".pretranslate", language: @language.name, count: todo.size), pretranslate_path(@language.code),
                    params: { unit_ids: todo.map(&:id) }, class: "rounded border border-violet-300 bg-violet-50 px-2 py-0.5 text-violet-900" %>
    <% end %>
  </div>

  <%# Column headers, on the rows' grid : reference choice over the source, the language over its editor.
      The grid keeps the rows' 1px border ; the language's name sits over the editor's text (its 1px border + px-3),
      the outer controls on the toolbar's edges. %>
  <div class="mb-2 grid grid-cols-1 items-center gap-y-2 border border-transparent md:grid-cols-2">
    <div class="-ml-px flex items-center gap-1 text-xs text-stone-500">
      <%= t(".reference") %>
      <% if @en %>
        <% User::REFERENCE_LANGUAGES.each do |code| %>
          <button type="button" data-reference-target="button" data-action="reference#choose" data-reference-code-param="<%= code %>"
                  aria-pressed="<%= code == current_user.reference_language %>"
                  class="rounded px-1.5 py-0.5 text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white"><%= code.upcase %></button>
        <% end %>
      <% else %>
        <%# No en to choose (the en list itself) : the fr source is the only reference %>
        <span class="rounded bg-stone-800 px-1.5 py-0.5 text-white">FR</span>
      <% end %>
    </div>
    <div class="-mr-px flex min-w-0 items-center justify-between gap-3 md:pl-[13px]">
      <%# unsaved-guard counts the unsaved edits here ; a click scrolls to the first one %>
      <div class="flex min-w-0 items-center gap-2">
        <% if @language_stats %>
          <%# Another language, same list : the filters and sort are kept, except the user one (offered per language) %>
          <span data-controller="popover" data-popover-align-value="left" class="contents">
            <h2 class="-ml-1.5 text-lg font-semibold">
              <button type="button" popovertarget="language-switch" data-popover-target="anchor" title="<%= t(".switch_language") %>"
                      class="flex items-center gap-1 rounded px-1.5 hover:bg-stone-200">
                <%= @language.name %>
                <span class="text-sm text-stone-500" aria-hidden="true">▾</span>
              </button>
            </h2>
            <div id="language-switch" popover data-popover-target="panel" data-action="beforetoggle->popover#place"
                 class="m-0 max-h-[70vh] min-w-48 overflow-y-auto rounded border border-stone-200 bg-white p-1 text-sm text-stone-700 shadow-lg">
              <% @language_stats.each do |language, s| %>
                <% on = language == @language %>
                <%= link_to translate_path(language.code, list_params.except(:user)), aria: { current: (on || nil) },
                            class: "flex w-full items-center gap-2 rounded px-3 py-1.5 outline-none hover:bg-stone-100 focus-visible:bg-stone-100" do %>
                  <span class="w-3 shrink-0 text-xs text-stone-800"><%= "✓" if on %></span>
                  <span class="flex-1"><%= language.name %></span>
                  <span class="text-xs text-stone-400"><%= language.code.upcase %></span>
                  <%# As on the home page : translated (outdated included) over the translators' keys %>
                  <%= render "shared/progress_bar", stats: s, css: "h-1.5 w-16 shrink-0" %>
                  <span class="w-9 text-right text-xs text-stone-500 tabular-nums"
                        title="<%= t('languages.index.todo', count: s[:total] - s[:translated]) %>"><%= progress_percent(s[:translated], s[:total]) %></span>
                <% end %>
              <% end %>
            </div>
          </span>
        <% else %>
          <h2 class="text-lg font-semibold"><%= @language.name %></h2>
        <% end %>
        <%# Shortcuts to the outdated and not translated keys, the other filters kept (their counts are the menu's) ;
            pressed when it is the only status, a click then drops it. A single index is exclusive : left out either way.
            Hidden without matches, unless pressed (to drop it). "More…" opens the search bar's filters menu, under its button,
            shown along with one of them at least %>
        <% shortcuts = %w[outdated not_translated].select { |status| @counts[status].positive? || statuses == [status] } %>
        <% if shortcuts.any? %>
          <div class="flex shrink-0 items-center gap-1">
            <% shortcuts.each do |status| %>
              <% on = statuses == [status] %>
              <% status_params = list_params.except(:status).merge(on ? {} : { status: [status] }) %>
              <% status_params = status_params.except(:at) unless status_params[:at].to_s.include?("-") %>
              <% label = t("shared.search_bar.statuses.#{status}") %>
              <%= link_to translate_path(@language.code, status_params), aria: { pressed: on },
                          title: t(on ? ".remove_status" : ".only_status", status: label),
                          class: "flex items-center gap-1.5 rounded border border-stone-300 bg-white px-2 py-0.5 text-xs text-stone-700 hover:bg-stone-100 aria-pressed:border-stone-800 aria-pressed:bg-stone-800 aria-pressed:text-white" do %>
                <%= status_dot(status) %>
                <%= label %>
                <span class="tabular-nums opacity-70"><%= number_with_delimiter(@counts[status]) %></span>
              <% end %>
            <% end %>
            <button type="button" popovertarget="search-filters"
                    class="rounded border border-stone-300 bg-white px-2 py-0.5 text-xs text-stone-700 hover:bg-stone-100"><%= t(".more_filters") %></button>
          </div>
        <% end %>
        <button type="button" hidden data-unsaved-guard-target="count" data-action="unsaved-guard#reveal"
                class="rounded bg-sky-50 px-2 py-0.5 text-sm text-sky-800 hover:bg-sky-100"></button>
      </div>
      <div class="flex items-center gap-1">
        <button type="button" data-controller="html-toggle" data-action="html-toggle#toggle"
                data-html-toggle-class-value="hide-keys" data-html-toggle-key-value="ocl-localize.show-keys" data-html-toggle-inverse-value="true"
                title="<%= t(".show_keys") %>" aria-label="<%= t(".show_keys") %>"
                class="flex h-5 w-5 items-center justify-center rounded text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
          </svg>
        </button>
        <button type="button" data-controller="html-toggle" data-action="html-toggle#toggle"
                data-html-toggle-class-value="show-ws" data-html-toggle-key-value="ocl-localize.show-whitespace" title="<%= t(".show_whitespace") %>"
                class="flex h-5 w-5 items-center justify-center rounded font-mono text-xs text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white">¶</button>
      </div>
    </div>
  </div>
</div>

<div class="flex flex-col gap-3">
  <%= render "page" %>
</div>
</div>
<% if @units.empty? %>
  <%= render "shared/empty_list", counts: @counts,
             unfiltered_url: translate_path(@language.code, list_params.except(:status, :questions, :warnings)) %>
<% end %>
