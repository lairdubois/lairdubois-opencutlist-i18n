<%# Toggles the row's comments panel (disclosure on the row) ; replaced by the thread when it renders, to follow new comments %>
<button type="button" id="comments_button_<%= unit.id %>_<%= language.code %>" data-disclosure-target="button" data-action="disclosure#toggle"
        class="group/comments mr-auto flex min-w-0 items-center gap-1 rounded px-1 text-left text-xs hover:bg-stone-100 aria-expanded:bg-stone-100 <%= question ? 'font-medium text-sky-700' : count.zero? ? 'text-stone-400' : 'text-stone-900' %>">
  <%= chevron_icon("group-aria-expanded/comments:rotate-90") %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
  </svg>
  <%= t(".comments", count: count) %><%= " · #{t('.open_question')}" if question %>
</button>
