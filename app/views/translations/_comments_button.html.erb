<%# Toggles the row's comments panel (disclosure on the row) ; replaced by the thread when it renders, to follow new comments.
    questions, admin_notes : open ones (admin notes : admins only, else always 0), as badges %>
<button type="button" id="comments_button_<%= unit.id %>_<%= language.code %>" data-disclosure-target="button" data-action="disclosure#toggle"
        class="group/comments mr-auto flex min-w-0 items-center gap-1 rounded px-1 text-left text-xs hover:bg-stone-100 aria-expanded:bg-stone-100 <%= count.zero? ? 'text-stone-400' : 'text-stone-900' %>">
  <%= chevron_icon("group-aria-expanded/comments:rotate-90") %>
  <%= comment_icon %>
  <%= t(".comments", count: count) %>
  <% if questions.positive? %><span class="ml-1 rounded bg-sky-200 px-1.5 font-medium text-sky-900"><%= t(".questions", count: questions) %></span><% end %>
  <% if admin_notes.positive? %><span class="ml-1 rounded bg-teal-200 px-1.5 font-medium text-teal-900"><%= t(".admin_notes", count: admin_notes) %></span><% end %>
</button>
