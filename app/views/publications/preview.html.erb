<% diffs = file_diffs(@result.staged.patch) %>
<h1 class="mb-2 text-lg font-semibold"><%= t(".title") %></h1>
<p class="mb-4 text-sm text-stone-600"><%= t(".intro_html", branch: Rails.configuration.x.ocl.i18n_branch, base: OclRepo.base_branch) %></p>

<% if @result.warnings.any? %>
  <section class="mb-6 rounded border border-amber-300 bg-amber-50 p-4 text-sm">
    <h2 class="mb-2 font-semibold text-amber-900"><%= t("publications.show.warnings", count: @result.warnings.size) %></h2>
    <% @result.warnings.each do |w| %><p class="mb-1 break-all font-mono text-xs"><%= w %></p><% end %>
  </section>
<% end %>

<% if @result.renames.any? || @result.deleted.any? %>
  <section class="mb-6 grid grid-cols-2 gap-4 text-sm">
    <div class="rounded border border-stone-200 bg-white p-4">
      <h2 class="mb-2 font-semibold"><%= t("publications.show.renames", count: @result.renames.size) %></h2>
      <% @result.renames.each do |o, n| %><p class="break-all font-mono text-xs"><del class="text-stone-400"><%= o %></del> → <%= n %></p><% end %>
    </div>
    <div class="rounded border border-stone-200 bg-white p-4">
      <h2 class="mb-2 font-semibold"><%= t(".deleted", count: @result.deleted.size) %></h2>
      <% @result.deleted.each do |k| %><p class="break-all font-mono text-xs"><%= k %></p><% end %>
    </div>
  </section>
<% end %>

<section class="mb-6 rounded border border-stone-200 bg-white text-sm">
  <h2 class="border-b border-stone-200 px-4 py-2 font-semibold"><%= t("publications.show.files", count: diffs.size) %></h2>
  <% diffs.each do |d| %>
    <details class="border-b border-stone-100 last:border-0" <%= "open" if d.lines.size <= 60 %>>
      <summary class="flex cursor-pointer gap-3 px-4 py-1.5">
        <span class="font-mono text-xs"><%= d.path %></span>
        <span class="ml-auto font-mono text-xs"><span class="text-green-700">+<%= d.additions %></span> <span class="text-red-700">−<%= d.deletions %></span></span>
      </summary>
      <pre class="overflow-x-auto border-t border-stone-100 py-1 font-mono text-xs leading-5"><% diff_rows(d.lines.first(PublicationsHelper::MAX_LINES)).each do |l, content| %><div class="whitespace-pre-wrap break-all px-4 <%= diff_line_class(l) %>"><%= l[0] || " " %><%= content %></div><% end %></pre>
      <% if d.lines.size > PublicationsHelper::MAX_LINES %>
        <p class="border-t border-stone-100 px-4 py-1.5 text-xs text-stone-500"><%= t(".truncated", count: d.lines.size - PublicationsHelper::MAX_LINES) %></p>
      <% end %>
    </details>
  <% end %>
</section>

<div class="flex items-center gap-3">
  <% if @can_push %>
    <%= button_to t(".publish"), publications_path, params: { digest: @result.staged.digest },
                  class: "rounded bg-stone-800 px-4 py-2 text-white", form: { data: { turbo: false } } %>
  <% else %>
    <p class="rounded border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-900"><%= t("publications.index.disabled_html") %></p>
  <% end %>
  <%= link_to t(".cancel"), publications_path, class: "text-sm text-stone-600 underline" %>
</div>
