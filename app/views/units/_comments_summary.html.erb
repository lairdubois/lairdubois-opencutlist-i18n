<%# The key page's comments header : kept in step by the thread when a comment is added or resolved %>
<span id="unit_comments_summary_<%= unit.id %>" class="ml-auto flex items-center gap-2 text-xs font-normal text-stone-500 tabular-nums">
  <% if questions.positive? %><span class="font-medium text-sky-700"><%= t(".open_questions", count: questions) %></span><% end %>
  <span><%= t(".comments", count: count) %></span>
</span>
