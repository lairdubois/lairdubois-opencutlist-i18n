<% content_for :title, "#{t(".title")} · #{@language.name} · OpenCutList Localize" %>
<%# Toolbar (title, states, search) stays on screen above the list (.toolbar in application.css) %>
<div class="toolbar">
  <div class="mb-2 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <h1 class="text-lg font-semibold"><%= t(".title") %> · <%= link_to @language.name, translate_path(@language.code), class: "hover:underline" %></h1>
    <%= render "states" %>
    <p class="basis-full text-sm text-stone-600"><%= t(".intro") %></p>
  </div>
  <div class="mb-2 flex flex-wrap items-start gap-3">
    <%= render "search_bar" %>
  </div>
</div>

<div class="flex flex-col gap-3">
  <% @issues.each do |issue| %>
    <%= render "issue", issue: issue, translation: @translations[issue.unit_id], index: @indexes[issue.unit_id] %>
  <% end %>
  <% if @issues.empty? %><p class="text-sm text-stone-500"><%= t(@filters.empty? ? ".empty" : ".empty_filtered") %></p><% end %>
</div>
