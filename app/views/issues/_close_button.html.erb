<%# locals: (issue:, row: false) %>
<%# Resolved : closes the issue. row : from a panel (translator's row, key page), answered with streams (IssuesController#close) %>
<%= button_to t("issues.index.resolve"), close_issue_path(issue), method: :patch, params: (row ? { row: 1 } : {}),
              class: "shrink-0 rounded border border-emerald-600 bg-white px-2 py-0.5 text-emerald-700 hover:bg-emerald-50" %>
