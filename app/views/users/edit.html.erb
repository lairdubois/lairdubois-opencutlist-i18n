<h1 class="mb-4 text-lg font-semibold"><%= @user.name %></h1>
<%= render "form" %>
<div class="mt-4 flex items-center gap-6">
  <%= button_to t(".invite"), invite_user_path(@user), class: "text-sm text-stone-700 hover:underline",
                form: { data: { turbo_confirm: t(".invite_confirm", email: @user.email) } } %>
  <%= button_to t(".destroy"), @user, method: :delete, class: "text-sm text-red-700 hover:underline",
                form: { data: { turbo_confirm: t(".destroy_confirm", name: @user.name) } } %>
</div>
