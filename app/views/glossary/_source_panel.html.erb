<%# locals: (term:, form:) %>
<%# The side panel (glossary_panel) on a fr term : its forms and definition or, for the admins, its edit
    form (saved by GlossaryController#save_source), archiving / restoring ; its fr history in a lazy panel %>
<section data-controller="disclosure" class="rounded border border-stone-200 bg-white text-sm">
  <div class="flex items-center justify-between gap-2 border-b border-stone-200 py-1 pr-1 pl-3 text-xs text-stone-600">
    <span><strong class="text-stone-900"><%= Language::SOURCE_CODE.upcase %></strong> · <%= t("glossary.source_panel.title") %></span>
    <button type="button" title="<%= t("glossary.cell_panel.close") %>" data-action="glossary-table#close"
            class="flex h-6 w-6 items-center justify-center rounded leading-none text-stone-500 hover:bg-stone-100 hover:text-stone-900">×</button>
  </div>

  <div class="px-3 py-2">
    <% if form %>
      <%= form_with model: term, url: glossary_term_source_path(term, **column_params), method: :patch, class: "grid gap-3", data: { controller: "dirty-form" } do |f| %>
        <%= render "term_fields", f: f, term: term %>
        <div class="flex items-center justify-end gap-3">
          <%= link_to t("cancel"), glossary_term_source_path(term, **column_params), class: "text-stone-600 underline" %>
          <%= f.submit t("save"), class: "rounded bg-stone-800 px-3 py-1 text-white" %>
        </div>
      <% end %>
    <% else %>
      <div class="flex items-start justify-between gap-2">
        <p class="min-w-0 font-mono font-medium break-words" lang="<%= Language::SOURCE_CODE %>"><%= term.term %></p>
        <span class="flex shrink-0 gap-1">
          <% if term.no_translate %>
            <span class="mt-0.5 rounded bg-stone-200 px-1 text-xs whitespace-nowrap text-stone-600"><%= t("glossary.term.no_translate") %></span>
          <% end %>
          <% if term.archived? %>
            <span class="mt-0.5 rounded bg-stone-200 px-1 text-xs text-stone-600"><%= t("glossary.cell_panel.archived") %></span>
          <% end %>
        </span>
      </div>
      <% if term.variants %><p class="font-mono text-xs break-words text-stone-500"><%= term.variants %></p><% end %>
      <% if term.definition %>
        <p class="-mx-3 mt-2 border-t border-dashed border-stone-200 px-3 pt-1.5 text-xs whitespace-pre-line text-stone-600" lang="en"><%= term.definition %></p>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2 border-t border-stone-200 px-3 py-1 text-xs">
    <button type="button" data-disclosure-target="button" data-action="disclosure#toggle"
            class="group/history flex items-center gap-1 rounded px-1 text-stone-400 hover:bg-stone-100 aria-expanded:bg-stone-100">
      <%= chevron_icon("group-aria-expanded/history:rotate-90") %>
      <%= t("glossary.term.history") %>
    </button>
    <span class="ml-auto"></span>
    <% if current_user.admin? && !form %>
      <%# Leave the frame : the list changes %>
      <% if term.archived? %>
        <%= button_to t("glossary.term.delete"), glossary_term_path(term, **column_params), method: :delete,
                      form: { data: { turbo_frame: "_top", turbo_confirm: t("glossary.term.delete_confirm", term: term.term) } },
                      class: "rounded px-1.5 text-stone-500 hover:bg-stone-100 hover:text-red-700" %>
        <%= button_to t("glossary.term.restore"), restore_glossary_term_path(term, **column_params), method: :patch,
                      form: { data: { turbo_frame: "_top" } }, class: "rounded px-1.5 text-stone-600 hover:bg-stone-100" %>
      <% else %>
        <%= button_to t("glossary.term.archive"), archive_glossary_term_path(term, **column_params), method: :patch,
                      form: { data: { turbo_frame: "_top", turbo_confirm: t("glossary.term.archive_confirm", term: term.term) } },
                      class: "rounded px-1.5 text-stone-500 hover:bg-stone-100 hover:text-red-700" %>
        <%= link_to t("glossary.term.edit"), glossary_term_source_path(term, edit: 1, **column_params), data: { glossary_edit: true },
                    class: "rounded border border-stone-300 px-1.5 text-stone-600 hover:border-stone-400 hover:text-stone-900" %>
      <% end %>
    <% end %>
  </div>
  <div data-disclosure-target="panel" hidden class="border-t border-stone-200 px-3 py-2 text-xs">
    <%= turbo_frame_tag "glossary_history_#{term.id}", src: glossary_term_history_path(term, code: Language::SOURCE_CODE), loading: :lazy do %>
      <span class="text-stone-400"><%= t("loading") %></span>
    <% end %>
  </div>
</section>
