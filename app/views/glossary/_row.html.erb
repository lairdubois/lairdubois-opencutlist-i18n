<%# locals: (term:, selected:) %>
<%# A term's row, its cells laid out by the table's grid (the wrapper is display: contents) : the fr term and its
    forms, its definition in the tooltip (opens its side panel), then a cell per column (glossary/_cell), or a band when it's kept as is. selected : the
    code of the cell shown in the side panel. Replaced by a stream after the fr term's save ; a new term's appended, then
    moved to its place (data-sort, glossary_table_controller) %>
<%= tag.div id: dom_id(term, :row), class: "contents", data: { glossary_table_target: "row", sort: SqliteFold.fold(term.term) } do %>
  <%= link_to glossary_term_source_path(term, **column_params), title: term.definition,
              aria: { current: (true if selected == Language::SOURCE_CODE), label: "#{Language::SOURCE_CODE.upcase} · #{term.term}" },
              data: { turbo_frame: "glossary_panel", glossary_cell: Language::SOURCE_CODE, action: "glossary-table#select", glossary_table_target: ("current" if selected == Language::SOURCE_CODE) },
              class: ["sticky left-0 z-10 block min-w-0 border-r border-b border-r-stone-300 border-b-stone-200 bg-white px-3 py-2 outline-none hover:bg-stone-50",
                      "focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-inset",
                      "aria-[current]:bg-sky-50 aria-[current]:ring-2 aria-[current]:ring-sky-600 aria-[current]:ring-inset",
                      ("text-stone-500" if term.archived?)] do %>
    <span class="flex items-start justify-between gap-2">
      <span class="min-w-0 font-mono font-medium break-words" lang="<%= Language::SOURCE_CODE %>"><%= term.term %></span>
      <% if term.no_translate %>
        <span class="mt-0.5 shrink-0 rounded bg-stone-200 px-1 text-xs whitespace-nowrap text-stone-600"><%= t("glossary.term.no_translate") %></span>
      <% end %>
    </span>
    <% if term.variants %><span class="block font-mono text-xs break-words text-stone-500"><%= term.variants %></span><% end %>
  <% end %>
  <% if term.no_translate %>
    <div class="col-[2/-1] border-b border-stone-200 bg-stone-100 px-3 py-2 text-xs text-stone-500 italic"><%= t("glossary.term.kept_as_is") %></div>
  <% else %>
    <% @columns.each do |language| %>
      <%= render "cell", term: term, language: language, entry: @matrix.dig(term.id, language.id), selected: selected == language.code %>
    <% end %>
  <% end %>
<% end %>
