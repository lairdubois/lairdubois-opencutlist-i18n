<%# posted (optional) : the comment just added, a reply's folded block is unfolded to show it %>
<% comments = (language ? unit.comments.visible_in(language) : unit.comments).visible_to(current_user).includes(:user, :language).to_a %>
<% replies = comments.select(&:reply?).group_by(&:parent_id) %>
<% posted = local_assigns[:posted] %>
<%= turbo_frame_tag ["comments", unit.id, language&.code].compact.join("_") do %>
  <%# The replies' group unfolds from the footer's count, "Répondre" unfolds it and focuses its field %>
  <div class="flex flex-col gap-2 text-sm">
    <% comments.reject(&:reply?).each do |c| %>
      <% if c.takes_replies? %>
        <% answers = replies[c.id] || [] %>
        <%# Shown while open with replies, folded once resolved (unless one was just added), hidden without any until "Répondre" %>
        <% shown = answers.any? && (!c.resolved? || posted&.parent_id == c.id) %>
        <div class="flex flex-col gap-2" data-controller="disclosure">
          <% reply_link = button_tag(type: "button", data: { action: "disclosure#open" }, class: "flex items-center gap-1 hover:text-stone-900") { reply_icon + t(".reply") } %>
          <% footer = capture do %>
            <div class="mt-1 flex items-center gap-2 text-xs text-stone-500">
              <%= reply_link %>
              <% if answers.any? %>
                <button type="button" data-disclosure-target="button" data-action="disclosure#toggle"
                        class="group/count flex items-center gap-1 border-l border-stone-300 pl-2 hover:text-stone-900">
                  <%= comment_icon %>
                  <span><strong class="text-stone-700"><%= answers.size %></strong> <%= t(".replies", count: answers.size) %></span>
                  <%= chevron_icon("rotate-90 group-aria-expanded/count:-rotate-90") %>
                </button>
              <% end %>
            </div>
          <% end %>
          <%= render "comments/comment", c: c, language: language, footer: footer %>
          <div data-disclosure-target="panel" <%= "hidden" unless shown %> class="ml-6 flex flex-col gap-2">
            <% answers.each do |r| %>
              <%= render "comments/comment", c: r, parent: c, language: language,
                                             footer: tag.div(reply_link, class: "mt-1 flex text-xs text-stone-500") %>
            <% end %>
            <%= form_with url: unit_comments_path(unit, lang: language&.code), class: "flex flex-col gap-1", data: { controller: "dirty-form" } do %>
              <%= hidden_field_tag :parent_id, c.id, id: nil %>
              <%= text_area_tag :body, nil, rows: 1, required: true, placeholder: t(".reply_placeholder"), id: nil,
                                data: { controller: "autosize", action: "input->autosize#resize", disclosure_focus: true },
                                class: "block w-full resize-none overflow-hidden rounded border border-stone-300 bg-white px-2 py-1" %>
              <div class="flex justify-end text-xs">
                <%= submit_tag t(".send"), class: "rounded bg-stone-800 px-2 py-1 text-white" %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= render "comments/comment", c: c, language: language %>
      <% end %>
    <% end %>
    <%# The translator's comments are questions in their language, or an admin's notes ; the key page's ones address every
        language : a plain comment, a question or an admin note. The kind is picked in a segmented switch (radios), the first by default. %>
    <% kinds = language ? (current_user.admin? ? %w[question admin_note] : []) : %w[comment question admin_note] %>
    <% kind_colors = { "comment" => "has-checked:bg-stone-200 has-checked:text-stone-900", "question" => "has-checked:bg-sky-200 has-checked:text-sky-900",
                       "admin_note" => "has-checked:bg-teal-200 has-checked:text-teal-900" } %>
    <%# Each kind's placeholder, set on the field when picked (placeholder_controller) %>
    <% placeholders = { "comment" => t(".placeholder"), "question" => t(language ? ".question_placeholder" : ".all_question_placeholder"),
                        "admin_note" => t(".admin_note_placeholder") } %>
    <%= form_with url: unit_comments_path(unit, lang: language&.code), class: "flex flex-col gap-1", data: { controller: "dirty-form placeholder" } do %>
      <%= text_area_tag :body, nil, rows: 2, required: true, placeholder: placeholders[kinds.first || "question"],
                        data: { controller: "autosize", action: "input->autosize#resize", placeholder_target: "field" },
                        class: "block w-full resize-none overflow-hidden rounded border border-stone-300 px-2 py-1" %>
      <div class="flex items-center gap-3 text-xs">
        <% if kinds.any? %>
          <span role="radiogroup" class="flex divide-x divide-stone-300 overflow-hidden rounded border border-stone-300 bg-white">
            <% kinds.each_with_index do |kind, i| %>
              <label class="cursor-pointer px-2 py-1 text-stone-600 hover:bg-stone-50 has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-stone-500 <%= kind_colors[kind] %>">
                <%= radio_button_tag :kind, kind, i.zero?, id: nil, class: "sr-only",
                                     data: { dirty_ignore: true, placeholder: placeholders[kind], action: "change->placeholder#set" } %><%= t(".kinds.#{kind}") %>
              </label>
            <% end %>
          </span>
        <% end %>
        <%= submit_tag t(".send"), class: "ml-auto rounded bg-stone-800 px-2 py-1 text-white" %>
      </div>
    <% end %>
  </div>
  <%# Keeps the translator's comments button, or the key page's comments header, in step (count, open questions and admin notes) %>
  <% if language %>
    <%= turbo_stream.replace "comments_button_#{unit.id}_#{language.code}",
                             partial: "translations/comments_button",
                             locals: { unit: unit, language: language, count: comments.size, questions: comments.count(&:open_question?),
                                       admin_notes: comments.count(&:open_admin_note?) } %>
  <% else %>
    <%= turbo_stream.replace "unit_comments_summary_#{unit.id}", partial: "units/comments_summary",
                             locals: { unit: unit, count: comments.size, questions: comments.count(&:open_question?),
                                       admin_notes: comments.count(&:open_admin_note?) } %>
  <% end %>
<% end %>
