# /etc/ocl-localize.env — owner root:ocl-localize, mode 640
RAILS_ENV=production
# Generated by deploy/setup.sh ; never change it once in use (it encrypts the admins' GitHub tokens)
SECRET_KEY_BASE=
PORT=3007
BINDING=127.0.0.1
SOLID_QUEUE_IN_PUMA=1
RAILS_LOG_LEVEL=info

OCL_HOST=localize.opencutlist.org
# OCL branch fr.yml is synced with and published from, until one is chosen on the sync page
# (set by deploy/setup.sh from OCL_BASE_BRANCH)
OCL_BASE_BRANCH=master

# GitHub App (publishing, admins' GitHub accounts) and push webhook : while empty, publishing is off
OCL_GITHUB_APP_ID=
OCL_GITHUB_APP_PRIVATE_KEY=/var/www/localize.opencutlist.org/github-app.pem
OCL_GITHUB_APP_CLIENT_ID=
OCL_GITHUB_APP_CLIENT_SECRET=
OCL_GITHUB_WEBHOOK_SECRET=

# Suggestions and consistency reviews by Claude Code through /api/* (openssl rand -hex 32) : the API is off while empty
OCL_API_TOKEN=

# E-mails : off until explicitly enabled
OCL_MAIL_ENABLED=0
OCL_MAIL_FROM="OpenCutList Localize <noreply@lairdubois.fr>"
SMTP_ADDRESS=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
# Certificate check : skipped for localhost, verified otherwise ; "none" or "peer" forces it
SMTP_OPENSSL_VERIFY_MODE=

# Migration : the Transifex import only reads from Transifex
TRANSIFEX_TOKEN=
TRANSIFEX_RESOURCE=v6
